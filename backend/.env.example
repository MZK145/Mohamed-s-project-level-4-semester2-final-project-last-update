# Backend Configuration
PORT=5000

# MongoDB Atlas connection
MONGO_URI=mongodb+srv://your_username:your_password@your_cluster.mongodb.net/metro?retryWrites=true&w=majority

# Use a long random secret (32+ characters) in production
JWT_SECRET=replace-with-a-long-random-secret

# Admin bootstrap credentials used only by createAdmin.js
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
